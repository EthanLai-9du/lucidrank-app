{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LucidRank",
  "version": "0.1.7",
  "identifier": "hk.lucidrank.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LucidRank",
        "url": "index.html",
        "width": 1080,
        "height": 740,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "backgroundColor": "#0a0a0c",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src https://www.youtube-nocookie.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "LucidRank",
    "category": "Utility",
    "shortDescription": "Daily check-in and match log for VALORANT / CS2 players",
    "longDescription": "Daily state, match performance, lineups and optional account sync. No memory reading, overlay or screen capture.",
    "copyright": "© 2026 LucidRank",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4MzExMDZEQzFFMTYxMDMKUldRRFllSEJiUkF4R0tpTkJ2Q0hmMlo3TUZiVXJSSWw0Q2FhMzV4V1M3VktHeDBFVytKSDhlcDcK",
      "endpoints": [
        "https://lucidrank.pages.dev/update/latest.json",
        "https://github.com/EthanLai-9du/lucidrank-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
